# Only the modules listed in ../modules (plus their dependencies) instead of MODULES=most:
# ~24 MB -> ~6 MB (hwdb.bin is dropped by ../hooks/zz-prune-hwdb), faster for the old U-Boot to
# load and to unpack. MODULES=dep cannot be used:
# the initramfs is built in a chroot whose /proc and /sys are the build host's.
MODULES=list
